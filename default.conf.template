server {

  listen       $PORT;
  listen  [::]:$PORT;
  server_name  localhost;
  location / {
    root   /usr/share/nginx/html;
    index  index.html index.htm;
  }

  # Redirect requests made to /api
  location /api {
    proxy_pass http://flags-be-env.eba-qxmknt2v.us-west-1.elasticbeanstalk.com/api;
  }
}